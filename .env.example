# 環境変数テンプレート
# cp .env.example .env

# SQLite のDBファイル（相対パスはプロジェクトルート基準）
DB_PATH=data/liver_statistics.db
# DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO

# OCR（Tesseract）設定
OCR_LANG=jpn+eng
# 空の場合は PATH から探す
TESSERACT_CMD=
# この値未満の信頼度を「要確認」とする（0-100）
CONFIDENCE_THRESHOLD=60
# アイコン検出のマッチ率の閾値（0-1）
ICON_MATCH_THRESHOLD=0.7
# 類似名と判定する類似度の閾値（0-1）
NAME_SIMILARITY_THRESHOLD=0.8
# この文字数以上の名前は、編集距離1（1文字違い）でも類似名とみなす
NAME_EDIT_MIN_LENGTH=3
# Tesseract 1回の呼び出しのタイムアウト（秒）
TESSERACT_TIMEOUT_SEC=30
# 数値を Tesseract にフォールバックして読む際の言語
NUMBER_OCR_LANG=eng
# 高精度モデル（tessdata_best）の置き場所。jpn/eng の学習データがあれば名前を2モデルで読む（既定: assets/tessdata_best）
# TESSDATA_BEST_DIR=assets/tessdata_best
# 2モデルの名前が食い違ったときの信頼度の上限（CONFIDENCE_THRESHOLD より小さくする）
NAME_DISAGREE_CONFIDENCE_CAP=55
# 桁テンプレートとの距離がこの値のとき信頼度0（大きいほど信頼度が下がりにくい）
DIGIT_MAX_DISTANCE=0.30

# 任意: 画面レイアウト設定・アイコン画像の場所
# OCR_LAYOUT_PATH=config/ocr_layout.toml
# ICONS_DIR=assets/icons
# DIGITS_DIR=assets/digits
